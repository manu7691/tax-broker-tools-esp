{#-
  Spanish Tax Report template (HTML -> PDF).

  Rendered by tax_engine.report.ReportRenderer.generate_html_content. Autoescape
  is intentionally OFF: the report embeds trusted HTML (its own <strong>/<br>/<em>
  markup and notes from the user's own brokerage files), matching the original
  string-concatenation renderer. Bilingual text is kept inline ({% if is_es %})
  so language pairs stay co-located; money/date/share formatting uses the custom
  filters registered on the environment (num2, num4, fx4, shares, ld).
-#}
{%- macro ledger_table(events, is_es) -%}
<table class='ledger'>
{%- if not is_es %}
<tr><th>Date</th><th class='tipo'>Type</th><th>Broker</th><th>Shares</th><th>Price (orig.)</th><th>FX Rate</th><th>Price (EUR)</th><th>Total Value (EUR)</th><th>Portfolio Qty</th><th>Avg Cost (EUR)</th><th>Realized G/L (EUR)</th></tr>
{%- else %}
<tr><th>Fecha</th><th class='tipo'>Tipo</th><th>Bróker</th><th>Acciones</th><th>Precio (orig.)</th><th>Tipo Cambio</th><th>Precio (EUR)</th><th>Valor Total (EUR)</th><th>Cant. Cartera</th><th>Coste Medio (EUR)</th><th>G/P Realizada (EUR)</th></tr>
{%- endif %}
{%- for pe in events %}{% set e = pe.event %}
<tr>
<td>{{ e.event_date | ld(is_es) }}</td>
<td class='tipo'>{{ e.event_type | tetype(is_es) }}<br><small style='color:gray;'>{{ e.notes | tnotes(is_es) }}</small></td>
<td>{{ e.broker }}</td>
<td>{{ '+' if e.event_type.value != 'SELL' else '-' }}{{ e.shares | shares }}</td>
<td>{% if e.currency == 'USD' %}${{ e.price_usd | num2 }}{% else %}{{ e.price_usd | num2 }} {{ e.currency }}{% endif %}</td>
<td>{{ e.resolved_fx_rate | fx4 }}</td>
<td>{{ e.price_eur | eur4 }}</td>
<td>{{ e.total_value_eur | eur }}</td>
<td>{{ pe.total_shares_after | shares }}</td>
<td>{{ pe.avg_cost_eur_after | eur4 }}</td>
<td>
{%- if pe.realized_gain_loss != 0 -%}
<strong>{{ pe.realized_gain_loss | eur }}</strong>
{%- if pe.event.event_type.value == 'SELL' and pe.realized_gain_loss < 0 and 'Wash Sale Blocked' in pe.event.notes -%}
<br><small style='color:red;'>{{ 'Bloqueado Regla 2 Meses' if is_es else 'Wash Sale Blocked' }}</small>
{%- endif -%}
{%- elif e.event_type.value == 'SELL' -%}{{ 0 | eur }}{%- endif -%}
</td>
</tr>
{%- for match in pe.fifo_matches %}
<tr style='background-color:#fafafa; font-style:italic;'>
<td></td>
<td colspan='3' style='text-align:right;'>{{ 'Cruce FIFO:' if is_es else 'FIFO Match:' }}</td>
<td colspan='6'>{% if is_es %}Se cruzaron {{ match.shares | shares }} acciones de la adquisición del {{ match.acquisition_date.strftime('%d/%m/%Y') }} a {{ match.acquisition_price_eur | eur4 }}{% else %}Matched {{ match.shares | shares }} shares from acquisition on {{ match.acquisition_date }} at {{ match.acquisition_price_eur | eur4 }}{% endif %}</td>
<td>{{ match.realized_gain_loss | eur }}</td>
</tr>
{%- endfor %}
{%- endfor %}
</table>
{%- endmacro -%}

{%- macro calc_details(events, is_es) -%}
{%- set sells = events | selectattr('event.event_type.value', 'equalto', 'SELL') | list -%}
{%- if not sells %}
<p><em>{{ 'No se encontraron transacciones de venta.' if is_es else 'No sales transactions found.' }}</em></p>
{%- endif %}
{%- for pe in sells %}{% set e = pe.event %}
<h3>{{ loop.index }}. {% if is_es %}Venta el {{ e.event_date.strftime('%d/%m/%Y') }}{% else %}Sale on {{ e.event_date.isoformat() }}{% endif %}</h3>
<ul>
<li><strong>{% if is_es %}Vendido: {{ e.shares | shares }} acciones @ {{ e.price_eur | eur4 }}{% else %}Sold: {{ e.shares | shares }} shares @ {{ e.price_eur | eur4 }}{% endif %}</strong></li>
<li><strong>{{ 'Cruces de Lotes FIFO' if is_es else 'FIFO Lot Matches' }}</strong>:</li>
<ul>
{%- for match in pe.fifo_matches %}
<li>{% if is_es %}Cruza {{ match.shares | shares }} acciones adquiridas el {{ match.acquisition_date.strftime('%d/%m/%Y') }} @ {{ match.acquisition_price_eur | eur4 }}. Ganancia/Pérdida{% else %}Matched {{ match.shares | shares }} shares acquired on {{ match.acquisition_date }} @ {{ match.acquisition_price_eur | eur4 }}. Gain/Loss{% endif %}: <code>({{ e.price_eur | num4 }} - {{ match.acquisition_price_eur | num4 }}) * {{ match.shares | shares }} = {{ match.realized_gain_loss | eur }}</code></li>
{%- endfor %}
</ul>
<li><strong>{{ 'Total Ganancia/Pérdida Realizada' if is_es else 'Total Realized Gain/Loss' }}</strong>: <strong>{{ pe.realized_gain_loss | eur }}</strong></li>
{%- if 'Wash Sale Blocked' in pe.event.notes %}
<li><strong style='color:red;'>{% if is_es %}Aviso de Regla de 2 Meses: Esta pérdida está bloqueada según la ley española debido a la compra de acciones homogéneas en un plazo de 2 meses.{% else %}Wash Sale Warning: This loss is blocked under Spanish rules due to a purchase of homogenous shares within 2 months.{% endif %}</strong></li>
{%- endif %}
</ul>
{%- endfor %}
{%- endmacro -%}
<html><head><style>body { font-family: sans-serif; max-width: 800px; margin: 0 auto; padding: 20px; }* { box-sizing: border-box; }table { border-collapse: collapse; width: 100%; margin-bottom: 20px; font-size: 12px; }th, td { border: 1px solid #ddd; padding: 6px; text-align: left; }td.tipo, th.tipo { overflow-wrap: anywhere; word-break: break-word; }.ledger { font-size: 9px; }.ledger td.tipo, .ledger th.tipo { width: 200px; }.ledger td, .ledger th { padding: 4px; }th { background-color: #f2f2f2; }h1, h2, h3 { color: #333; }.gain { color: green; }.loss { color: red; }code { background-color: #f4f4f4; padding: 2px 4px; border-radius: 4px; }h2 { page-break-before: always; }h2:first-of-type { page-break-before: avoid; }h2, h3 { page-break-after: avoid; }table { page-break-inside: auto; }tr, li { page-break-inside: avoid; }</style></head><body>
<h1>{{ 'Informe Fiscal de España (FIFO)' if is_es else 'Spanish Tax Report' }}</h1>
<p>{{ 'Generado el' if is_es else 'Generated on' }}: {{ today_str }}</p>
<p style='font-size: 11px; color: #555; background-color: #f4f4f4; padding: 8px; border-left: 4px solid #999;'>
{%- if is_es %}
<strong>Cobertura:</strong> este informe incluye únicamente ejercicios <strong>completos</strong> (hasta {{ max_year }}). El año en curso ({{ max_year + 1 }}) se excluye de todas las tablas por no haber finalizado y no ser aún declarable; sus operaciones sí se tienen en cuenta en el cálculo FIFO de los lotes.
{%- else %}
<strong>Coverage:</strong> this report includes <strong>complete</strong> tax years only (through {{ max_year }}). The in-progress year ({{ max_year + 1 }}) is excluded from all tables — it isn't finished or declarable yet — though its transactions are still honoured in the FIFO lot calculation.
{%- endif %}
</p>
<h2>{{ 'Metodología' if is_es else 'Methodology' }}</h2>
{%- if not is_es %}
<p>This report calculates capital gains using the <strong>FIFO (First In First Out)</strong> method as required by Spanish tax law (Agencia Tributaria).</p>
<h3>Key Rules:</h3>
<ul>
<li><strong>FIFO Matching</strong>: Shares of the same security are sold in the order they were acquired. Sells are matched against the oldest available purchase lots.</li>
<li><strong>Spanish Tax Savings Scale</strong>: Progressive tax scale is applied: 19% up to €6,000; 21% up to €50,000; 23% up to €200,000; 27% up to €300,000; 28% over €300,000.</li>
<li><strong>2-Month Wash Sale Rule</strong>: Losses from sales are blocked (deferred) if homogenous shares are acquired within 2 months before or after the sale date.</li>
{%- if multi_broker %}
<li><strong style='color: #cc6600;'>SCOPE - Multiple Accounts</strong>: This report combines data from <strong>{{ brokers_joined }}</strong>, so FIFO and the 2-month wash-sale rule are applied across them together. If you also hold the same security at <strong>yet another</strong> broker/account not imported here, repurchases there within the 2-month window are NOT detected and some blocked losses may be under-reported.</li>
{%- else %}
<li><strong style='color: #cc6600;'>SCOPE - Single Account</strong>: The wash-sale rule applies per security across <strong>all</strong> your brokers/accounts, but this report only sees data from this account. If you bought the same security elsewhere (e.g. another broker) within the 2-month window, those repurchases are NOT detected here and some blocked losses may be under-reported.</li>
{%- endif %}
<li><strong style='color: green;'>NOTE - Fees Included</strong>: This report <strong>INCLUDES and DEDUCTS</strong> transaction commissions and SEC fees from your capital gains, applying the official ECB USD/EUR exchange rate of the transaction date. <strong>NOTE: Wire transfer fees are EXCLUDED per user preference.</strong></li>
{%- if multi_broker %}
<li><strong>Multi-Broker Scope</strong>: Transactions from more than one broker were combined ({{ brokers_joined }}). Each ledger row is tagged with its originating <strong>Broker</strong>, and FIFO matching plus the 2-month wash-sale rule are applied across all of them — as Spain requires for homogeneous securities (same ISIN). A per-broker realized gain/loss breakdown is shown below.</li>
{%- endif %}
</ul>
{%- else %}
<p>Este informe calcula las ganancias y pérdidas patrimoniales utilizando el método <strong>FIFO (First In First Out)</strong>, tal como exige la normativa fiscal española (Agencia Tributaria).</p>
<h3>Reglas Clave:</h3>
<ul>
<li><strong>Casación FIFO</strong>: Las acciones de un mismo valor se consideran vendidas en el orden de su adquisición. Las ventas se casan con los lotes de compra más antiguos disponibles.</li>
<li><strong>Escala de Gravamen del Ahorro</strong>: Se aplica la escala progresiva española: 19% hasta 6.000 €; 21% hasta 50.000 €; 23% hasta 200.000 €; 27% hasta 300.000 €; y 28% para importes superiores a 300.000 €.</li>
<li><strong>Regla de los 2 Meses (Wash Sale)</strong>: Las pérdidas patrimoniales quedan bloqueadas (diferidas) si se adquieren acciones homogéneas dentro de los 2 meses anteriores o posteriores a la fecha de la venta.</li>
{%- if multi_broker %}
<li><strong style='color: #cc6600;'>ALCANCE - Varias Cuentas</strong>: Este informe combina datos de <strong>{{ brokers_joined }}</strong>, por lo que el FIFO y la regla de los 2 meses se aplican entre ellos en conjunto. Si además tienes el mismo valor en <strong>otra</strong> cuenta/bróker no importada aquí, las recompras allí dentro de la ventana de 2 meses NO se detectan y algunas pérdidas bloqueadas podrían estar infravaloradas.</li>
{%- else %}
<li><strong style='color: #cc6600;'>ALCANCE - Una Sola Cuenta</strong>: La regla de los 2 meses se aplica por valor en <strong>todos</strong> tus brókers/cuentas, pero este informe solo ve los datos de esta cuenta. Si compraste el mismo valor en otro lugar (p. ej. otro bróker) dentro de la ventana de 2 meses, esas recompras NO se detectan aquí y algunas pérdidas bloqueadas podrían estar infravaloradas.</li>
{%- endif %}
<li><strong style='color: green;'>NOTA - Comisiones Incluidas</strong>: Este informe <strong>INCLUYE y DEDUCE</strong> las comisiones de transacción y tasas SEC como gastos inherentes a la transmisión, utilizando el tipo de cambio oficial del BCE de la fecha exacta de la transacción. <strong>NOTA: Las tarifas de transferencia bancaria (Wire fees) se EXCLUYEN por preferencia del usuario.</strong></li>
{%- if multi_broker %}
<li><strong>Ámbito Multi-Bróker</strong>: Se combinaron operaciones de más de un bróker ({{ brokers_joined }}). Cada fila del libro indica su <strong>Bróker</strong> de origen, y la casación FIFO junto con la regla de los 2 meses se aplican entre todos ellos — como exige España para los valores homogéneos (mismo ISIN). Más abajo se muestra un desglose de ganancias/pérdidas realizadas por bróker.</li>
{%- endif %}
</ul>
{%- endif %}
{# ---- "What to declare in Hacienda" consolidated summary ---- #}
<h2>{{ '¿Qué declarar en Hacienda? — Resumen por Ejercicio' if is_es else 'What to Declare — Summary by Year' }}</h2>
{%- if not is_es %}
<p>The exact figures to enter in the Renta (Modelo 100), grouped by the three IRPF buckets. The <strong>integrated savings base</strong> already reflects the cross-category offset and 4-year loss carryforward simulated in the tables further below. Casilla numbers are indicative — <strong>confirm them against the form for your filing year</strong>.</p>
{%- else %}
<p>Las cifras exactas a introducir en la Renta (Modelo 100), agrupadas por las tres categorías del IRPF. La <strong>base del ahorro integrada</strong> ya refleja la compensación entre categorías y el arrastre de pérdidas a 4 años que se simulan en las tablas de más abajo. Los números de casilla son orientativos — <strong>confírmalos en el modelo de tu ejercicio</strong>.</p>
{%- endif %}
{%- for y in hacienda_years %}
<h3>{{ 'Ejercicio' if is_es else 'Tax Year' }} {{ y.year }}</h3>
<table>
{%- if not is_es %}
<tr><th>Concept</th><th>Amount (EUR)</th><th>Casilla (verify)</th></tr>
<tr><th colspan='3' style='background-color:#eaf2ff;'>1) Rendimientos del trabajo (salary income)</th></tr>
<tr><td colspan='3' style='font-size:11px; color:#555;'>RSU vesting and the ordinary ESPP discount are <strong>already on your payroll (nómina)</strong> and pre-filled by Hacienda — do <strong>not</strong> re-enter them from this report.</td></tr>
{%- if y.espp_early %}
<tr><td>ESPP sold before 3-year holding (Complementaria for {{ y.year }})</td><td><strong style='color:#cc0000;'>{{ y.espp_early | eur }}</strong></td><td>trabajo boxes</td></tr>
{%- endif %}
<tr><th colspan='3' style='background-color:#eaf2ff;'>2) Base del ahorro — savings base</th></tr>
<tr><td><strong>a) Capital gains/losses on shares</strong></td><td></td><td>≈ 0328–0344</td></tr>
<tr><td>&nbsp;&nbsp;&nbsp;Transmission value (valor de transmisión)</td><td>{{ y.transm_value | eur }}</td><td></td></tr>
<tr><td>&nbsp;&nbsp;&nbsp;Acquisition value (valor de adquisición)</td><td>{{ y.acq_value | eur }}</td><td></td></tr>
<tr><td>&nbsp;&nbsp;&nbsp;Less: transaction fees (gastos)</td><td>−{{ y.fees | eur }}</td><td></td></tr>
{%- if y.blocked > 0 %}
<tr><td>&nbsp;&nbsp;&nbsp;Add back: 2-month blocked losses (deferred, not deductible this year)</td><td>+{{ y.blocked | eur }}</td><td></td></tr>
{%- endif %}
<tr><td>&nbsp;&nbsp;&nbsp;<strong>Net saldo integrated into the base (deductible){{ ' — shares' if y.crypto_saldo is not none else '' }}</strong></td><td class='{{ 'gain' if y.saldo_neto >= 0 else 'loss' }}'><strong>{{ y.saldo_neto | eur }}</strong></td><td>saldo ≈ 0424/0425</td></tr>
{%- if y.crypto_saldo is not none %}
<tr><td><strong>a-bis) Crypto capital gains/losses (otros elementos patrimoniales)</strong></td><td class='{{ 'gain' if y.crypto_saldo >= 0 else 'loss' }}'><strong>{{ y.crypto_saldo | eur }}</strong></td><td>≈ 1624–1631</td></tr>
{%- endif %}
<tr><td><strong>b) Dividends + interest (RCM)</strong></td><td>{{ y.rcm | eur }}</td><td>≈ 0027–0031</td></tr>
<tr><td><strong>Integrated savings base (after offsets/carryforward)</strong></td><td class='{{ 'gain' if y.base_ahorro >= 0 else 'loss' }}'><strong>{{ y.base_ahorro | eur }}</strong></td><td>≈ 0460</td></tr>
{%- if y.foreign_tax > 0 %}
<tr><td>Foreign tax withheld (deducción doble imposición)</td><td>{{ y.foreign_tax | eur }}</td><td>≈ 0588/0589</td></tr>
{%- endif %}
{%- else %}
<tr><th>Concepto</th><th>Importe (EUR)</th><th>Casilla (verificar)</th></tr>
<tr><th colspan='3' style='background-color:#eaf2ff;'>1) Rendimientos del trabajo</th></tr>
<tr><td colspan='3' style='font-size:11px; color:#555;'>La concesión de RSU y el descuento ESPP ordinario <strong>ya constan en tu nómina</strong> y vienen en los datos fiscales de Hacienda — <strong>no</strong> los vuelvas a introducir desde este informe.</td></tr>
{%- if y.espp_early %}
<tr><td>ESPP vendido antes de 3 años (Complementaria del {{ y.year }})</td><td><strong style='color:#cc0000;'>{{ y.espp_early | eur }}</strong></td><td>casillas de trabajo</td></tr>
{%- endif %}
<tr><th colspan='3' style='background-color:#eaf2ff;'>2) Base del ahorro</th></tr>
<tr><td><strong>a) Ganancias/pérdidas patrimoniales (acciones)</strong></td><td></td><td>≈ 0328–0344</td></tr>
<tr><td>&nbsp;&nbsp;&nbsp;Valor de transmisión</td><td>{{ y.transm_value | eur }}</td><td></td></tr>
<tr><td>&nbsp;&nbsp;&nbsp;Valor de adquisición</td><td>{{ y.acq_value | eur }}</td><td></td></tr>
<tr><td>&nbsp;&nbsp;&nbsp;Menos: gastos (comisiones)</td><td>−{{ y.fees | eur }}</td><td></td></tr>
{%- if y.blocked > 0 %}
<tr><td>&nbsp;&nbsp;&nbsp;Se suma: pérdidas bloqueadas regla 2 meses (diferidas, no deducibles este año)</td><td>+{{ y.blocked | eur }}</td><td></td></tr>
{%- endif %}
<tr><td>&nbsp;&nbsp;&nbsp;<strong>Saldo neto a integrar en la base (deducible){{ ' — acciones' if y.crypto_saldo is not none else '' }}</strong></td><td class='{{ 'gain' if y.saldo_neto >= 0 else 'loss' }}'><strong>{{ y.saldo_neto | eur }}</strong></td><td>saldo ≈ 0424/0425</td></tr>
{%- if y.crypto_saldo is not none %}
<tr><td><strong>a-bis) Ganancias/pérdidas de cripto (otros elementos patrimoniales)</strong></td><td class='{{ 'gain' if y.crypto_saldo >= 0 else 'loss' }}'><strong>{{ y.crypto_saldo | eur }}</strong></td><td>≈ 1624–1631</td></tr>
{%- endif %}
<tr><td><strong>b) Dividendos + intereses (RCM)</strong></td><td>{{ y.rcm | eur }}</td><td>≈ 0027–0031</td></tr>
<tr><td><strong>Base del ahorro integrada (tras compensaciones/arrastre)</strong></td><td class='{{ 'gain' if y.base_ahorro >= 0 else 'loss' }}'><strong>{{ y.base_ahorro | eur }}</strong></td><td>≈ 0460</td></tr>
{%- if y.foreign_tax > 0 %}
<tr><td>Retención en origen (deducción doble imposición)</td><td>{{ y.foreign_tax | eur }}</td><td>≈ 0588/0589</td></tr>
{%- endif %}
{%- endif %}
</table>
{%- endfor %}
{%- if securities is not none %}
{# ---- Portfolio Summary by Security ---- #}
<h2>{{ 'Resumen de Cartera por Valor' if is_es else 'Portfolio Summary by Security' }}</h2>
{%- if not is_es %}
<p>Each security has its own FIFO queue (grouped by ISIN; the same ISIN across brokers is merged). The savings base, 4-year carryforward and 25% cross-category offset below operate on the <strong>portfolio total</strong>; the 2-month wash-sale rule stays <strong>per security</strong>.</p>
{%- else %}
<p>Cada valor tiene su propia cola FIFO (agrupada por ISIN; el mismo ISIN en distintos brókers se fusiona). La base del ahorro, la compensación a 4 años y el límite del 25% entre categorías de abajo operan sobre el <strong>total de la cartera</strong>; la regla de los 2 meses se mantiene <strong>por valor</strong>.</p>
{%- endif %}
<table>
{%- if not is_es %}
<tr><th>Security</th><th>ISIN</th><th>Broker(s)</th><th>Realized Gains</th><th>Deductible Losses</th><th>Net G/L</th><th>Open Position (shares)</th></tr>
{%- else %}
<tr><th>Valor</th><th>ISIN</th><th>Bróker(es)</th><th>Ganancias Realizadas</th><th>Pérdidas Deducibles</th><th>G/P Neta</th><th>Posición Abierta (acciones)</th></tr>
{%- endif %}
{%- for r in portfolio_rows %}
<tr><td>{{ r.label }}</td><td>{{ r.isin or '—' }}</td><td>{{ r.brokers }}</td><td>{{ r.gains | eur }}</td><td>{{ r.losses | eur }}</td><td class='{{ 'gain' if r.net >= 0 else 'loss' }}'><strong>{{ r.net | eur }}</strong></td><td>{{ r.shares | num4 }}</td></tr>
{%- endfor %}
<tr><td><strong>{{ 'Total (Cartera)' if is_es else 'Total (Portfolio)' }}</strong></td><td></td><td></td><td><strong>{{ portfolio_totals.gains | eur }}</strong></td><td><strong>{{ portfolio_totals.losses | eur }}</strong></td><td class='{{ 'gain' if portfolio_totals.net >= 0 else 'loss' }}'><strong>{{ portfolio_totals.net | eur }}</strong></td><td></td></tr>
</table>
{%- endif %}
{# ---- Yearly Tax Summary ---- #}
<h2>{{ 'Resumen Fiscal Anual (Modelo 100 - Base Imponible del Ahorro)' if is_es else 'Yearly Tax Summary (Modelo 100 - Savings Base)' }}</h2>
<table>
{%- if not is_es %}
<tr><th>Year</th><th>Total Gains</th><th>Total Losses</th><th>Blocked Losses (2-month rule)</th><th>Deductible Losses</th><th>Fees Deducted</th><th>Net Taxable Savings Base</th><th>Estimated Tax (Isolated)*</th></tr>
{%- else %}
<tr><th>Año</th><th>Ganancias Totales</th><th>Pérdidas Totales</th><th>Pérdidas Bloqueadas (Regla 2 meses)</th><th>Pérdidas Deducibles</th><th>Gastos Deducidos</th><th>Base Imponible del Ahorro</th><th>Impuesto Estimado (Aislado)*</th></tr>
{%- endif %}
{%- for summary in summaries %}
<tr>
<td>{{ summary.year }}</td>
<td>{{ summary.total_gains | eur }}</td>
<td>{{ summary.total_losses | eur }}</td>
<td>{{ summary.blocked_losses | eur }}</td>
<td>{{ summary.deductible_losses | eur }}</td>
<td>{{ summary.total_fees_eur | eur }}</td>
<td class='{{ 'gain' if summary.taxable_gain >= 0 else 'loss' }}'><strong>{{ summary.taxable_gain | eur }}</strong></td>
<td><strong>{{ summary.tax_due | eur }}</strong></td>
</tr>
{%- endfor %}
</table>
{%- if not is_es %}
<p style='font-size: 11px; color: #555;'><strong>* Isolated estimate.</strong> The tax column applies the savings-base scale to these stock gains <em>alone</em>. Your actual liability depends on your <strong>total</strong> savings income for the year (dividends, interest, gains from other assets) and any losses carried forward from prior years (4-year limit, Art. 49 LIRPF). Use this figure as a guide, not as the final tax due.</p>
{%- else %}
<p style='font-size: 11px; color: #555;'><strong>* Estimación aislada.</strong> La columna de impuesto aplica la escala del ahorro a estas ganancias bursátiles de forma <em>aislada</em>. Tu cuota real depende de tu base del ahorro <strong>total</strong> del ejercicio (dividendos, intereses, ganancias de otros activos) y de las pérdidas pendientes de compensar de años anteriores (límite de 4 años, Art. 49 LIRPF). Usa esta cifra como orientación, no como la cuota definitiva.</p>
{%- endif %}
{%- if deferral_rows %}
{# ---- Outstanding Art. 33.5.f deferrals ---- #}
<h2>{{ 'Pérdidas Diferidas del Art. 33.5.f Pendientes de Integrar' if is_es else 'Outstanding Deferred Losses (Art. 33.5.f)' }}</h2>
{%- if not is_es %}
<p style='font-size: 11px; color: #555;'>What the 2-month rule still has locked up, and the lot that has to be transmitted to free it. These deferrals <strong>do not expire</strong>: unlike the four-year limit on carrying a negative savings balance forward (Art. 49 LIRPF), they simply wait until the replacement shares leave your estate. Two dates, because both matter: the balance at the last complete year end, which belongs with the declared years, and the balance today.</p>
{%- else %}
<p style='font-size: 11px; color: #555;'>Lo que la regla de los 2 meses mantiene bloqueado, y el lote que hay que transmitir para liberarlo. Estas diferidas <strong>no caducan</strong>: a diferencia del límite de cuatro años para arrastrar un saldo negativo del ahorro (Art. 49 LIRPF), sencillamente esperan a que las acciones de reemplazo salgan de tu patrimonio. Se dan dos fechas porque ambas importan: el saldo al cierre del último ejercicio completo, que acompaña a los ejercicios declarados, y el saldo de hoy.</p>
{%- endif %}
<table>
{%- if not is_es %}
<tr><th>Origin Year</th><th>Pending at {{ deferral_cutoff | ld(is_es) }}</th><th>Pending today ({{ deferral_today | ld(is_es) }})</th><th>Lot holding it</th><th>Broker</th><th>Shares left in lot</th></tr>
{%- else %}
<tr><th>Año origen</th><th>Pendiente a {{ deferral_cutoff | ld(is_es) }}</th><th>Pendiente hoy ({{ deferral_today | ld(is_es) }})</th><th>Lote que lo retiene</th><th>Bróker</th><th>Acciones vivas del lote</th></tr>
{%- endif %}
{%- for r in deferral_rows %}
<tr><td>{{ r.origin_year }}</td><td class='loss'>{{ r.pending_cutoff | eur }}</td><td class='loss'>{{ r.pending_today | eur }}</td><td>{{ r.lot_date | ld(is_es) }}</td><td>{{ r.lot_broker }}</td><td>{{ r.lot_shares_today | shares }}</td></tr>
{%- endfor %}
<tr><td><strong>Total</strong></td><td class='loss'><strong>{{ deferral_totals.pending_cutoff | eur }}</strong></td><td class='loss'><strong>{{ deferral_totals.pending_today | eur }}</strong></td><td></td><td></td><td></td></tr>
</table>
{%- if not is_es %}
{%- if deferral_forfeited > 0 %}
<p style='font-size: 11px; color: #555;'><strong>Does not tie to the yearly table, by exactly {{ deferral_forfeited | eur }}.</strong> That much deferred loss did release — the block broke — so it is not pending above; but this run renounces its integration, so the yearly table does not credit it either. It is neither pending nor deducted: it is given up. Any other difference between the two would be an error.</p>
{%- endif %}
<p style='font-size: 11px; color: #555;'>A lot showing 0 shares left has already been transmitted, yet its deferral may still be pending: the loss is only integrated by a transmission that is <em>definitive</em> — one with no repurchase of homogeneous securities in the following two months (DGT V3282-18, V0046-20, V1119-21). Until that condition is met the loss keeps waiting, which is why a fully sold lot can still carry a balance here.</p>
{%- else %}
{%- if deferral_forfeited > 0 %}
<p style='font-size: 11px; color: #555;'><strong>No cuadra con la tabla anual, y la diferencia es exactamente {{ deferral_forfeited | eur }}.</strong> Esa pérdida diferida sí se liberó — el bloqueo se rompió — así que no figura como pendiente arriba; pero esta ejecución renuncia a integrarla, así que la tabla anual tampoco la acredita. No está ni pendiente ni deducida: está cedida. Cualquier otra diferencia entre ambas tablas sí sería un error.</p>
{%- endif %}
<p style='font-size: 11px; color: #555;'>Un lote con 0 acciones vivas ya se transmitió, pero su diferida puede seguir pendiente: la pérdida solo se integra con una transmisión <em>definitiva</em>, es decir, sin recompra de valores homogéneos en los 2 meses siguientes (DGT V3282-18, V0046-20, V1119-21). Mientras esa condición no se cumpla la pérdida sigue esperando, y por eso un lote íntegramente vendido puede conservar saldo aquí.</p>
{%- endif %}
{%- endif %}
{%- if multi_broker %}
{# ---- Realized Gains/Losses by Broker ---- #}
<h2>{{ 'Ganancias/Pérdidas Realizadas por Bróker' if is_es else 'Realized Gains/Losses by Broker' }}</h2>
{%- if not is_es %}
<p style='font-size: 11px; color: #555;'>Attributed to the broker where each sale occurred. Because FIFO is applied across all brokers, a sale may draw on shares acquired at another broker; this table splits the <em>realized result</em> by selling broker, not by acquisition.</p>
{%- else %}
<p style='font-size: 11px; color: #555;'>Atribuidas al bróker donde se produjo cada venta. Como el FIFO se aplica entre todos los brókers, una venta puede consumir acciones adquiridas en otro bróker; esta tabla reparte el <em>resultado realizado</em> por bróker vendedor, no por adquisición.</p>
{%- endif %}
<table>
{%- if not is_es %}
<tr><th>Broker</th><th>Realized Gains</th><th>Realized Losses (gross)</th><th>Net Realized G/L (gross)</th></tr>
{%- else %}
<tr><th>Bróker</th><th>Ganancias Realizadas</th><th>Pérdidas Realizadas (brutas)</th><th>G/P Neta Realizada (bruta)</th></tr>
{%- endif %}
{%- for r in broker_rows %}
<tr><td>{{ r.broker }}</td><td>{{ r.gains | eur }}</td><td>{{ r.losses | eur }}</td><td class='{{ 'gain' if r.net >= 0 else 'loss' }}'><strong>{{ r.net | eur }}</strong></td></tr>
{%- endfor %}
<tr><td><strong>Total</strong></td><td><strong>{{ broker_totals.gains | eur }}</strong></td><td><strong>{{ broker_totals.losses | eur }}</strong></td><td class='{{ 'gain' if broker_totals.net >= 0 else 'loss' }}'><strong>{{ broker_totals.net | eur }}</strong></td></tr>
</table>
{%- if not is_es %}
<p style='font-size: 11px; color: #555;'><strong>Reconciliation — this total is not the figure to declare.</strong> The gross realized result (<strong>{{ broker_bridge.gross_net | eur }}</strong>){% if broker_bridge.blocked > 0 %}, plus the losses Art. 33.5.f defers, which do not reduce the base yet ({{ broker_bridge.blocked | eur }}){% endif %}{% if broker_bridge.released > 0 %}, minus the earlier deferrals released this period ({{ broker_bridge.released | eur }}){% endif %}, gives the computable result of <strong>{{ broker_bridge.computable_net | eur }}</strong> — the same total shown in the portfolio table and used in the Modelo 100 tables above.{% if broker_bridge.forfeited > 0 %} Separately, {{ broker_bridge.forfeited | eur }} of deferred losses are <strong>not</strong> integrated at all: they were already deducted in a closed year and this run gives up their release rather than amending that year.{% endif %} Declare the yearly figures, never this multi-year total.</p>
{%- else %}
<p style='font-size: 11px; color: #555;'><strong>Conciliación — este total no es la cifra a declarar.</strong> El resultado realizado bruto (<strong>{{ broker_bridge.gross_net | eur }}</strong>){% if broker_bridge.blocked > 0 %}, más las pérdidas que difiere el Art. 33.5.f y que todavía no reducen la base ({{ broker_bridge.blocked | eur }}){% endif %}{% if broker_bridge.released > 0 %}, menos las diferidas de ejercicios anteriores liberadas en este período ({{ broker_bridge.released | eur }}){% endif %}, da el resultado computable de <strong>{{ broker_bridge.computable_net | eur }}</strong> — el mismo total del Resumen de Cartera y el que usan las tablas del Modelo 100 de arriba.{% if broker_bridge.forfeited > 0 %} Aparte, hay {{ broker_bridge.forfeited | eur }} de pérdidas diferidas que <strong>no</strong> se integran: ya se dedujeron en un ejercicio cerrado y esta ejecución renuncia a su liberación en lugar de regularizar aquel ejercicio.{% endif %} Declara las cifras <em>por ejercicio</em>, nunca este total plurianual.</p>
{%- endif %}
{%- endif %}
{%- if use_savings %}
{# ---- Savings Base (two-bucket) ---- #}
<h2>{{ 'Base del Ahorro — Ganancias + Dividendos/Intereses (Art. 49 LIRPF)' if is_es else 'Savings Base — Capital Gains + Dividends/Interest (Art. 49 LIRPF)' }}</h2>
{%- if not is_es %}
<p>Combines your stock gains/losses with dividend & interest income (RCM). A net loss in one category offsets up to the legal cap (25% from 2018) of the other category's positive balance; the rest carries forward 4 years. <strong>Foreign tax withheld is shown for reference only</strong> — the <em>deducción por doble imposición internacional</em> is applied by your advisor.</p>
{%- else %}
<p>Combina tus ganancias/pérdidas bursátiles con los dividendos e intereses (RCM). Una pérdida neta en una categoría compensa hasta el límite legal (25% desde 2018) del saldo positivo de la otra; el resto se arrastra 4 años. <strong>La retención en origen se muestra solo a título informativo</strong> — la <em>deducción por doble imposición internacional</em> la aplica tu asesor.</p>
{%- endif %}
<table>
{%- if not is_es %}
<tr><th>Year</th><th>Capital G/L (net)</th><th>Dividends + Interest</th><th>Cross-Category Offset</th><th>Taxable Savings Base</th><th>Foreign Tax (info)</th></tr>
{%- else %}
<tr><th>Año</th><th>Ganancia/Pérdida (neta)</th><th>Dividendos + Intereses</th><th>Compensación entre Categorías</th><th>Base del Ahorro Imponible</th><th>Retención Origen (info)</th></tr>
{%- endif %}
{%- for r in sledger.rows %}
<tr>
<td>{{ r.year }}</td>
<td class='{{ 'gain' if r.gp_net >= 0 else 'loss' }}'>{{ r.gp_net | eur }}</td>
<td>{{ r.rcm_net | eur }}</td>
<td>{% if r.cross_offset > 0 %}{{ r.cross_offset | eur }}{% else %}—{% endif %}</td>
<td><strong>{{ r.savings_base | eur }}</strong></td>
<td>{{ r.foreign_tax_eur | eur }}</td>
</tr>
{%- endfor %}
</table>
{%- if sledger.total_foreign_tax > 0 %}
{%- if not is_es %}
<p style='font-size: 11px; color: #555;'><em>Total foreign tax withheld: {{ sledger.total_foreign_tax | eur }} — claim as deducción por doble imposición internacional (advisor).</em></p>
<p style='font-size: 11px; color: #555;'><em>Spain's tax treaties cap the foreign-tax credit at the treaty rate (<strong>15%</strong> for US dividends). Withholding above that is not creditable here — reclaim the excess from the source country (e.g. a corrected W-8BEN / US 1040-NR).</em></p>
{%- else %}
<p style='font-size: 11px; color: #555;'><em>Retención total en origen: {{ sledger.total_foreign_tax | eur }} — reclámala como deducción por doble imposición internacional (asesor).</em></p>
<p style='font-size: 11px; color: #555;'><em>Los convenios de doble imposición limitan la deducción al tipo del convenio (<strong>15%</strong> para dividendos de EE. UU.). La retención por encima de ese límite no es deducible aquí — reclama el exceso al país de origen (p. ej. un W-8BEN corregido / 1040-NR de EE. UU.).</em></p>
{%- endif %}
{%- if over15_flagged %}
{%- if not is_es %}
<p style='font-size: 11px; color: #cc6600;'><em>⚠️ Effective withholding above 15% detected: {{ over15_flagged }}. Only 15% is creditable in Spain; reclaim the rest at source.</em></p>
{%- else %}
<p style='font-size: 11px; color: #cc6600;'><em>⚠️ Retención efectiva superior al 15% detectada: {{ over15_flagged }}. Solo el 15% es deducible en España; reclama el resto en origen.</em></p>
{%- endif %}
{%- endif %}
{%- endif %}
{%- if sledger.gp_pending_end %}
<p><strong>{{ 'Pérdidas patrimoniales pendientes de compensar:' if is_es else 'Pending capital losses carried forward:' }}</strong></p><ul>
{%- for oy, rem, ub in sledger.gp_pending_end %}
<li class='loss'>{{ oy }}: {{ rem | eur }} — {{ 'usar antes de' if is_es else 'use by' }} {{ ub }}</li>
{%- endfor %}
</ul>
{%- endif %}
{%- if sledger.rcm_pending_end %}
<p><strong>{{ 'Pérdidas de RCM (dividendos/intereses) pendientes de compensar:' if is_es else 'Pending RCM (dividend/interest) losses carried forward:' }}</strong></p><ul>
{%- for oy, rem, ub in sledger.rcm_pending_end %}
<li class='loss'>{{ oy }}: {{ rem | eur }} — {{ 'usar antes de' if is_es else 'use by' }} {{ ub }}</li>
{%- endfor %}
</ul>
{%- endif %}
{%- if sledger.expired %}
<p style='color:#cc0000;'><strong>{{ '⚠️ Pérdidas CADUCADAS sin usar (superado el límite de 4 años):' if is_es else '⚠️ Losses that EXPIRED unused (4-year limit passed):' }}</strong></p><ul>
{%- for bucket, oy, amount in sledger.expired %}
<li style='color:#cc0000;'>{{ bucket }} {{ oy }}: {{ amount | eur }}</li>
{%- endfor %}
</ul>
{%- endif %}
{%- else %}
{# ---- Loss Carryforward Ledger (single-bucket) ---- #}
<h2>{{ 'Libro de Compensación de Pérdidas (Art. 49 LIRPF)' if is_es else 'Loss Carryforward Ledger (Art. 49 LIRPF)' }}</h2>
{%- if not is_es %}
<p>Net losses in a year offset savings-base gains of the following <strong>4 years</strong> (oldest losses first); unused losses then expire. This ledger simulates that across the tracked years. Cross-category offset against other savings income (dividends, interest) is still applied by your advisor at filing time.</p>
{%- else %}
<p>Las pérdidas netas de un ejercicio compensan ganancias de la base del ahorro de los <strong>4 ejercicios siguientes</strong> (primero las más antiguas); las no utilizadas caducan. Este libro simula esa compensación entre los años analizados. La compensación con otras rentas del ahorro (dividendos, intereses) la aplica tu asesor al presentar la declaración.</p>
{%- endif %}
{%- if seed_str %}
<p style='font-size: 11px; color: #555;'><em>{% if is_es %}Inicializado con pérdidas pendientes de años anteriores — {{ seed_str }}{% else %}Seeded with prior-year pending losses — {{ seed_str }}{% endif %}</em></p>
{%- endif %}
<table>
{%- if not is_es %}
<tr><th>Year</th><th>Net Result</th><th>Prior-Year Loss Applied</th><th>Taxable After Carryforward</th></tr>
{%- else %}
<tr><th>Año</th><th>Resultado Neto</th><th>Pérdida de Años Anteriores Aplicada</th><th>Base Tras Compensación</th></tr>
{%- endif %}
{%- for r in cf_ledger.rows %}
<tr>
<td>{{ r.year }}</td>
<td class='{{ 'gain' if r.net_result >= 0 else 'loss' }}'>{{ r.net_result | eur }}</td>
<td>{{ r.prior_losses_applied | eur }}</td>
<td><strong>{{ r.taxable_after | eur }}</strong></td>
</tr>
{%- endfor %}
</table>
